diff --git a/src/touch_button.c b/src/touch_button.c
new file mode 100644
index 0000000..702a672
--- /dev/null
+++ b/src/touch_button.c
@@ -0,0 +1,120 @@
+/* esp32s3-fido: a capacitive touch pad works as the presence button in
+ * addition to BOOT. Measured on a SuperMini with a vinyl-insulated wire on
+ * GPIO1: idle ~16100 (noise +-10), hand nearby <= +2%, touch through the
+ * insulation ~+15%, bare metal > +500%. Touched = smooth > baseline + 8%.
+ * The hardware benchmark is not used: it follows a slow touch through the
+ * insulation. Our baseline drops at once (so touching while plugging in only
+ * delays detection until release) and rises slowly only while untouched. */
+#ifdef ESP_PLATFORM
+#include <stdio.h>
+#include "touch_button.h"
+#include "driver/touch_sens.h"
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+
+#define TOUCH_ON_PCT      8u    /* touched above baseline + 8 % */
+#define TOUCH_TRACK_PCT   4u    /* baseline may rise only while below +4 % */
+#define TOUCH_DEBOUNCE    3     /* consecutive samples (x 20 ms) */
+#define TOUCH_PERIOD_MS   20
+
+static volatile touch_button_info_t s_info;
+
+static void touch_task(void *arg) {
+    touch_channel_handle_t chan = (touch_channel_handle_t)arg;
+    uint32_t baseline = 0, v = 0;
+    uint32_t base_q8 = 0;   /* baseline * 256, for a slow fixed-point average */
+    int on = 0, off = 0;
+    for (;;) {
+        vTaskDelay(pdMS_TO_TICKS(TOUCH_PERIOD_MS));
+        if (touch_channel_read_data(chan, TOUCH_CHAN_DATA_TYPE_SMOOTH, &v) != ESP_OK || v == 0 || v > 0xFFFFFF) {
+            continue;
+        }
+        if (baseline == 0 || v < baseline) {
+            base_q8 = v << 8;                  /* follow downward at once */
+        }
+        else if (v < baseline + baseline / 100 * TOUCH_TRACK_PCT) {
+            /* upward: ~10 s time constant. Signed: v == baseline can still be
+             * below base_q8 because of its fractional part. */
+            base_q8 = (uint32_t)((int32_t)base_q8 + ((int32_t)(v << 8) - (int32_t)base_q8) / 512);
+        }
+        baseline = base_q8 >> 8;
+        bool active = v > baseline + baseline / 100 * TOUCH_ON_PCT;
+        if (active) {
+            off = 0;
+            if (on < TOUCH_DEBOUNCE && ++on == TOUCH_DEBOUNCE) {
+                s_info.pressed = true;
+            }
+        }
+        else {
+            on = 0;
+            if (off < TOUCH_DEBOUNCE && ++off == TOUCH_DEBOUNCE) {
+                s_info.pressed = false;
+            }
+        }
+        s_info.value = v;
+        s_info.baseline = baseline;
+        s_info.samples++;
+    }
+}
+
+void touch_button_start(int chan_id) {
+    if (s_info.status != 0) {
+        return;
+    }
+    s_info.status = -99;
+    touch_sensor_sample_config_t sample_cfg[TOUCH_SAMPLE_CFG_NUM] = {
+        TOUCH_SENSOR_V2_DEFAULT_SAMPLE_CONFIG(500, TOUCH_VOLT_LIM_L_0V5, TOUCH_VOLT_LIM_H_2V2)};
+    touch_sensor_config_t sens_cfg = TOUCH_SENSOR_DEFAULT_BASIC_CONFIG(1, sample_cfg);
+    touch_channel_config_t chan_cfg = {
+        .active_thresh = {2000},
+        .charge_speed = TOUCH_CHARGE_SPEED_7,
+        .init_charge_volt = TOUCH_INIT_CHARGE_VOLT_DEFAULT,
+    };
+    touch_sensor_filter_config_t filter_cfg = TOUCH_SENSOR_DEFAULT_FILTER_CONFIG();
+    touch_sensor_handle_t sens = NULL;
+    touch_channel_handle_t chan = NULL;
+    esp_err_t err;
+    if ((err = touch_sensor_new_controller(&sens_cfg, &sens)) != ESP_OK) {
+        s_info.status = -1;
+    }
+    else if ((err = touch_sensor_new_channel(sens, chan_id, &chan_cfg, &chan)) != ESP_OK) {
+        s_info.status = -2;
+    }
+    else if ((err = touch_sensor_config_filter(sens, &filter_cfg)) != ESP_OK) {
+        s_info.status = -3;
+    }
+    else if ((err = touch_sensor_enable(sens)) != ESP_OK) {
+        s_info.status = -4;
+    }
+    else {
+        for (int i = 0; i < 3; i++) {
+            touch_sensor_trigger_oneshot_scanning(sens, 2000);
+        }
+        if ((err = touch_sensor_start_continuous_scanning(sens)) != ESP_OK) {
+            s_info.status = -5;
+        }
+        else if (xTaskCreate(touch_task, "touch", 2048, chan, 5, NULL) != pdPASS) {
+            s_info.status = -6;
+            err = ESP_ERR_NO_MEM;
+        }
+        else {
+            s_info.status = 1;
+        }
+    }
+    if (s_info.status != 1) {
+        printf("touch: init failed at step %d [%d], BOOT button only\n", s_info.status, (int)err);
+    }
+}
+
+bool touch_button_pressed(void) {
+    return s_info.pressed;
+}
+
+void touch_button_info(touch_button_info_t *out) {
+    out->status = s_info.status;
+    out->samples = s_info.samples;
+    out->value = s_info.value;
+    out->baseline = s_info.baseline;
+    out->pressed = s_info.pressed;
+}
+#endif
diff --git a/src/touch_button.h b/src/touch_button.h
new file mode 100644
index 0000000..9c47e44
--- /dev/null
+++ b/src/touch_button.h
@@ -0,0 +1,22 @@
+/* esp32s3-fido: capacitive touch pad used as the user-presence button. */
+#ifndef TOUCH_BUTTON_H
+#define TOUCH_BUTTON_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+    int status;          /* 0 = not started, 1 = running, <0 = init step that failed */
+    uint32_t samples;    /* samples processed by the touch task */
+    uint32_t value;      /* last smooth value */
+    uint32_t baseline;   /* tracked untouched level */
+    bool pressed;        /* debounced state */
+} touch_button_info_t;
+
+/* Start sampling touch channel `chan` (TOUCH1 = GPIO1 ...). Safe to call once. */
+void touch_button_start(int chan);
+/* Debounced "finger on the pad" state. */
+bool touch_button_pressed(void);
+void touch_button_info(touch_button_info_t *out);
+
+#endif
