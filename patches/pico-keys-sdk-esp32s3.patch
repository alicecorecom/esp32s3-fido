diff --git a/src/fs/low_flash.c b/src/fs/low_flash.c
index 5ac7185..0a96765 100644
--- a/src/fs/low_flash.c
+++ b/src/fs/low_flash.c
@@ -32,10 +32,19 @@
  #ifdef ESP_PLATFORM
   #include "compat/esp_compat.h"
   #include "esp_partition.h"
+  #include "esp_heap_caps.h"
+  #include "freertos/FreeRTOS.h"
+  #include "freertos/task.h"
   const esp_partition_t *part0;
+  /* esp32s3-fido: part0 is NOT read through esp_partition_mmap(). With flash
+   * encryption enabled, every cache (mmap) read is decrypted, including data
+   * stored unencrypted, so mmap returns garbage. Instead `map` is a RAM mirror
+   * (PSRAM) of part0, filled with esp_partition_read() (never decrypts an
+   * unencrypted partition) and refreshed from flash after every erase/program. */
+  static void part0_mirror_refresh(uint32_t off, uint32_t len);
   #define save_and_disable_interrupts() 1
-  #define flash_range_erase(a,b) esp_partition_erase_range(part0, a, b)
-  #define flash_range_program(a,b,c) esp_partition_write(part0, a, b, c);
+  #define flash_range_erase(a,b) do { esp_partition_erase_range(part0, a, b); part0_mirror_refresh(a, b); } while (0)
+  #define flash_range_program(a,b,c) do { esp_partition_write(part0, a, b, c); part0_mirror_refresh(a, c); } while (0)
   #define restore_interrupts(a) (void)a
  #else
   #ifdef _MSC_VER
@@ -66,6 +75,26 @@
  uint8_t *map = NULL;
  #include <fcntl.h>
 #endif
+
+#ifdef ESP_PLATFORM
+static void part0_mirror_fatal(const char *what, esp_err_t err) {
+    printf("FATAL: part0 mirror: %s [%d]. Halting.\n", what, (int)err);
+    for (;;) {
+        vTaskDelay(portMAX_DELAY);
+    }
+}
+
+/* Re-read [off, off+len) of part0 from flash into the RAM mirror. */
+static void part0_mirror_refresh(uint32_t off, uint32_t len) {
+    if (map == NULL) {
+        return;
+    }
+    esp_err_t err = esp_partition_read_raw(part0, off, map + off, len);
+    if (err != ESP_OK) {
+        part0_mirror_fatal("read failed", err);
+    }
+}
+#endif
 #if defined(PICO_PLATFORM) || defined(ESP_PLATFORM)
 extern uint32_t FLASH_SIZE_BYTES;
 #else
@@ -351,11 +380,9 @@ void low_flash_task(void) {
             flash_available = false;
         }
 #ifdef ESP_PLATFORM
-        if (flash_updated && multicore_lockout_start_timeout_us(1000)) {
-            esp_partition_munmap(fd_map);
-            esp_partition_mmap(part0, 0, part0->size, ESP_PARTITION_MMAP_DATA, (const void **)&map, (esp_partition_mmap_handle_t *)&fd_map);
-            multicore_lockout_end_timeout_us(1000);
-        }
+        /* The RAM mirror is refreshed inside flash_range_erase/program, at the
+         * same address, so there is nothing to remap here. */
+        (void)flash_updated;
 #endif
 #if defined(PICO_PLATFORM) || defined(ESP_PLATFORM)
         out:
@@ -556,7 +583,14 @@ void low_flash_init(void) {
     uint32_t data_end_addr;
 #if defined(ESP_PLATFORM)
     part0 = esp_partition_find_first(0x40, 0x1, "part0");
-    esp_partition_mmap(part0, 0, part0->size, ESP_PARTITION_MMAP_DATA, (const void **)&map, (esp_partition_mmap_handle_t *)&fd_map);
+    if (part0 == NULL) {
+        part0_mirror_fatal("partition not found", ESP_ERR_NOT_FOUND);
+    }
+    map = heap_caps_malloc(part0->size, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT);
+    if (map == NULL) {
+        part0_mirror_fatal("no PSRAM for mirror", ESP_ERR_NO_MEM);
+    }
+    part0_mirror_refresh(0, part0->size);
     data_start_addr = 0;
     data_end_addr = part0->size;
     FLASH_SIZE_BYTES = part0->size;
