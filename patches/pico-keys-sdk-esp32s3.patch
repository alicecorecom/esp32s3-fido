+  /* esp32s3-fido: part0 is NOT read through esp_partition_mmap(). With flash
+   * encryption enabled, every cache (mmap) read is decrypted, including data
+   * stored unencrypted, so mmap returns garbage. Instead `map` is a RAM mirror
+   * (PSRAM) of part0, filled with esp_partition_read() (never decrypts an
+   * unencrypted partition) and refreshed from flash after every erase/program. */
+  static void part0_mirror_refresh(uint32_t off, uint32_t len);
