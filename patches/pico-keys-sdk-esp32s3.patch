diff --git a/src/led/led.c b/src/led/led.c
index 145cafb..eff26bc 100644
--- a/src/led/led.c
+++ b/src/led/led.c
@@ -53,8 +53,48 @@ void led_blink_n_times(uint8_t count, uint8_t color, uint32_t on_ms, uint32_t of
     blink_pending = true;
 }
 
+#ifdef ESP_PLATFORM
+#include "tusb.h"
+/* esp32s3-fido: drive the idle/error LED from the USB state.
+ * - first 3 s after boot without USB: dark (no red flash on every plug-in)
+ * - USB comes up: one 0.5 s blue flash, then the (dark) mounted mode
+ * - still no USB after 3 s (charge-only cable etc.): red blink */
+#define ESP32S3_FIDO_USB_GRACE_MS 3000
+static void esp32s3_fido_usb_led(uint32_t now) {
+    static bool was_mounted = false;
+    if (led_mode == MODE_FATAL) {
+        return;
+    }
+    bool mounted = tud_mounted();
+    if (mounted && !was_mounted) {
+        if (led_mode == MODE_NOT_MOUNTED) {
+            led_mode = MODE_MOUNTED;
+        }
+        led_blink_n_times(1, LED_COLOR_BLUE, 500, 1);
+    }
+    else if (!mounted) {
+        led_mode = now < ESP32S3_FIDO_USB_GRACE_MS && !was_mounted ? MODE_MOUNTED : MODE_NOT_MOUNTED;
+    }
+    was_mounted = mounted;
+}
+
+#include "freertos/FreeRTOS.h"
+#include "freertos/task.h"
+void led_fatal_halt(void) {
+    led_init();             /* may run before the normal led_init() */
+    led_set_mode(MODE_FATAL);
+    for (;;) {
+        led_blinking_task();
+        vTaskDelay(pdMS_TO_TICKS(10));
+    }
+}
+#endif
+
 void led_blinking_task(void) {
 #if defined(PICO_PLATFORM) || defined(ESP_PLATFORM)
+#ifdef ESP_PLATFORM
+    esp32s3_fido_usb_led(board_millis());
+#endif
     static uint32_t start_ms = 0;
     static uint32_t stop_ms = 0;
     static uint32_t last_led_update_ms = 0;
