+
+/* esp32s3-fido: capacitive touch pad used as the user-presence button. */
+#ifndef TOUCH_BUTTON_H
+#define TOUCH_BUTTON_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+typedef struct {
+    int status;          /* 0 = not started, 1 = running, <0 = init step that failed */
+    uint32_t samples;    /* samples processed by the touch task */
+    uint32_t value;      /* last smooth value */
+    uint32_t baseline;   /* tracked untouched level */
+    bool pressed;        /* debounced state */
+} touch_button_info_t;
+
+/* Start sampling touch channel `chan` (TOUCH1 = GPIO1 ...). Safe to call once. */
+void touch_button_start(int chan);
+/* Debounced "finger on the pad" state. */
+bool touch_button_pressed(void);
+void touch_button_info(touch_button_info_t *out);
+
+#endif
