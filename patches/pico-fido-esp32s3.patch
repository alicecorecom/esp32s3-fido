diff --git a/src/fido/fido.h b/src/fido/fido.h
index 100e07a..24fe71c 100644
--- a/src/fido/fido.h
+++ b/src/fido/fido.h
@@ -112,6 +112,14 @@ extern void set_opts(uint8_t);
 #define MAX_CREDBLOB_LENGTH       128
 #define MAX_MSG_SIZE              1024
 #define MAX_PIN_LENGTH            63
+/* esp32s3-fido: minimum PIN length while none has been set with
+ * authenticatorConfig (CTAP default 4). A snapshot restore of the flash resets
+ * the retry counter, so a short PIN can be brute-forced (README). */
+#ifdef ESP_PLATFORM
+#define DEFAULT_MIN_PIN_LENGTH 8
+#else
+#define DEFAULT_MIN_PIN_LENGTH 4
+#endif
 #define MAX_FRAGMENT_LENGTH       (MAX_MSG_SIZE - 64)
 #define MAX_LARGE_BLOB_SIZE       2048
 #define MAX_RPIDS_MINPIN_LENGTH   120
