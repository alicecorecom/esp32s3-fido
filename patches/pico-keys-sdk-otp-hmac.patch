+static void otp_hmac_derive(const char *label, uint8_t out[32]) {
+    esp_err_t err = esp_hmac_calculate(OTP_HMAC_KEY_ID, label, strlen(label), out);
+    if (err != ESP_OK) {
+        otp_fatal("HMAC failed", err);
