+void otp_platform_init(const uint8_t **otp_key_1_out, const uint8_t **otp_key_2_out) {
+    (void)read_key_from_efuse;
+    otp_hmac_provision();
+    otp_hmac_derive("pico-keys/otp_key_1", _otp_key_1);
+    /* otp_key_2 is used as a secp256k1 private key (rescue.c); an HMAC output is
+     * a valid scalar except with negligible probability (< 2^-127). */
+    otp_hmac_derive("pico-keys/otp_key_2", _otp_key_2);
+    *otp_key_1_out = _otp_key_1;
+    *otp_key_2_out = _otp_key_2;
+}
