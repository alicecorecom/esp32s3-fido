# Verification profile: flash encryption in DEVELOPMENT mode.
# Same encryption behaviour as release (cache reads are decrypted etc.), but the
# board can still be re-flashed with `.\idf.ps1 devenc -p COMx encrypted-flash`.
# The first boot burns eFuses (key block, SPI_BOOT_CRYPT_CNT, JTAG disable):
# the board can never go back to running unencrypted firmware.

CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_DEVELOPMENT=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
CONFIG_SECURE_FLASH_CHECK_ENC_EN_IN_APP=y
